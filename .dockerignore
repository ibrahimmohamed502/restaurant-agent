# .dockerignore — keeps the image build context small and secret-free.
# NOTE: the app image (root Dockerfile) and the web image (apps/web/Dockerfile)
# both build from the repository root as context.

node_modules
**/node_modules
.next
**/.next
npm-debug.log*
yarn-error.log*

# never ship secrets
.env
.env.*
!.env.example

# infra noise
.git
.gitignore
data/

# --- Group C: never bake operational artefacts or credentials into an image ---
# rollback source snapshots (contain a full copy of an older tree)
rollbacks/
# PostgreSQL dumps and plain-SQL backups created on the host
*.dump
**/*.dump
backup*.sql
**/backup*.sql
# any env-shaped file, wherever it lives (e.g. *_stack.env under rollbacks/)
*.env
**/*.env
