# =============================================================================
# Environment variable NAMES for the "restaurant-agent" stack.
# Copy to .env ON THE SERVER (never commit real values) and fill in.
# Portainer alternative: paste the same pairs into Stack → Environment variables.
# =============================================================================

# ---- application ----
PORT=3000
NODE_ENV=production

# ---- Meta / Facebook ----
WEBHOOK_VERIFY_TOKEN=
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_VERSION=v21.0
FB_PAGE_ID=738688299520738
FB_PAGE_ACCESS_TOKEN=

# ---- LLM provider ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODELS=
MAX_REPLIES_PER_USER_PER_HOUR=30

# ---- staff notifications (optional) ----
STAFF_ALERT_WEBHOOK_URL=
RESEND_API_KEY=
STAFF_EMAIL_TO=
STAFF_EMAIL_FROM=
DASHBOARD_PASSWORD=

# ---- data layer ----
POSTGRES_USER=lwc
POSTGRES_PASSWORD=
POSTGRES_DB=lwc_saas
# DATABASE_URL is derived by default (postgresql://user:pass@postgres:5432/db).
# Set it explicitly only when pointing at an external database.
DATABASE_URL=
REDIS_URL=redis://redis:6379
ENCRYPTION_KEY=

# ---- first-boot seed (optional; ignored when tenants already exist) ----
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
DATA_DIR=/tmp/lwc-data

# ---- processing mode (Stage 4 queue/worker) ----
WEBHOOK_QUEUE_MODE=inline
# Routes the browser UI to the Next.js web service (public hostname unchanged).
WEB_UPSTREAM=http://lwc-web:3000
WORKER_CONCURRENCY=5

# ---- frontend ----
# Empty → the web app proxies /api/* to restaurant-agent:3000 (same-origin).
API_CORS_ORIGINS=
NEXT_PUBLIC_API_URL=/api/v1
