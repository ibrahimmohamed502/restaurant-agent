# ======================= Server =======================
PORT=3000
# A random string YOU invent. Must match the "Verify Token" you type
# into the Meta webhook dashboard (App Dashboard → Webhooks → Page → Subscribe).
WEBHOOK_VERIFY_TOKEN=change_me_to_a_long_random_string

# ==================== Meta / Facebook ==================
# App Dashboard → Settings → Basic
FB_APP_ID=
FB_APP_SECRET=
# Graph API version used for all calls
FB_GRAPH_VERSION=v21.0
# Your Page ID (Facebook Page → About → Page ID)
FB_PAGE_ID=
# Long-lived Page Access Token with permissions:
#   pages_read_engagement, pages_manage_engagement, pages_show_list
FB_PAGE_ACCESS_TOKEN=

# ============ LLM (any OpenAI-compatible API) ==========
# Examples:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# Pick a model that handles JSON output + Arabic well
LLM_MODEL=gpt-4o-mini
# Backup models tried in order if the primary is overloaded (503) — comma-separated
LLM_FALLBACK_MODELS=

# =================== Agent behavior ====================
# Anti-abuse cap per commenter (genuine users never hit this;
# the "reply to every comment" guarantee still holds for them).
MAX_REPLIES_PER_USER_PER_HOUR=30
# Admin dashboard at https://<domain>/dashboard — REQUIRED to enable it
DASHBOARD_PASSWORD=change_me_strong_password
# Optional: URL that receives a POST when the agent escalates
# a complex reservation/complaint to staff (Slack, Discord, Zapier…)
STAFF_ALERT_WEBHOOK_URL=

# ---- Staff alerts via EMAIL (escalations: blogger collabs, complaints, contact data) ----
# Free at https://resend.com → sign up → API Keys → Create API Key (100 emails/day free)
RESEND_API_KEY=
# Who receives the alert emails? comma-separated for multiple people
STAFF_EMAIL_TO=
# Sender (the default resend.dev address works without any domain setup)
STAFF_EMAIL_FROM=LWC Bot <onboarding@resend.dev>
